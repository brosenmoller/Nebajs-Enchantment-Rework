{
	"schemaVersion": 1,
	"id": "nebajs-enchantment-rework",
	"version": "${version}",
	"name": "Nebaj's Enchantment Rework",
	"description": "Vanilla friendly enchantment rework. It replaces the enchanting table interface, moves treasure enchantments to specific structures, adds new enchantments, changes several existing ones, and changes how experience is earned and spent.",
	"authors": [
		"Nebaj"
	],
	"contact": {
		"homepage": "https://github.com/brosenmoller/Nebajs-Enchantment-Rework",
		"sources": "https://github.com/brosenmoller/Nebajs-Enchantment-Rework",
		"issues": "https://github.com/brosenmoller/Nebajs-Enchantment-Rework/issues"
	},
	"license": "MIT-License",
	"icon": "assets/nebajs-enchantment-rework/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.nebaj.nebajsenchantmentrework.NebajSEnchantmentRework"
		],
		"client": [
			"com.nebaj.nebajsenchantmentrework.NebajSEnchantmentReworkClient"
		],
		"fabric-datagen": [
			"com.nebaj.nebajsenchantmentrework.NebajSEnchantmentReworkDataGenerator"
		],
		"modmenu": [
			"com.nebaj.nebajsenchantmentrework.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"nebajs-enchantment-rework.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": ">=26.3.159"
	},
	"suggests": {
		"modmenu": "*"
	}
}